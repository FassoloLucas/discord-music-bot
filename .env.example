# Token do bot, gerado em https://discord.com/developers/applications
DISCORD_TOKEN=coloque_seu_token_aqui

# Opcional: ID de um servidor (guild) para sincronizar os slash commands
# instantaneamente durante o desenvolvimento. Deixe vazio em produção
# (sem GUILD_ID os comandos sincronizam globalmente, mas podem levar
# até ~1h para aparecer em todos os servidores).
GUILD_ID=

# Opcional: credenciais de um app do Spotify (gratuito), só para resolver
# título/artista de links do Spotify — o áudio é buscado por título/artista no
# SoundCloud, o Spotify não fornece o áudio para este bot.
# Criar em: https://developer.spotify.com/dashboard -> Create app
#   Redirect URI pode ser qualquer coisa, ex: http://localhost:8888/callback
#   (não é usado, mas o formulário exige preencher).
# Sem essas duas variáveis, links do Spotify simplesmente não funcionam;
# busca por nome, YouTube, SoundCloud etc. continuam normais.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Obrigatório pra tocar links diretos do YouTube (a busca por nome usa
# SoundCloud, não precisa disso): o YouTube bloqueia reprodução vinda de
# IPs de VPS/datacenter ("Sign in to confirm you're not a bot") sem um
# arquivo de cookies de uma conta logada. Veja o passo a passo em
# README.md > "Limitações".
YOUTUBE_COOKIES_FILE=

# NÃO configure isso ainda — deixe vazio. A ideia era contornar o
# LOGIN_REQUIRED do YouTube via Cloudflare WARP, mas na prática só a
# checagem de login é resolvida: o áudio não toca de verdade (o FFmpeg
# busca o stream por um IP diferente do que o yt-dlp usou pra resolver
# a URL, e o YouTube rejeita com 403). Ver README.md > "Limitações"
# antes de mexer aqui.
YOUTUBE_WARP_PROXY=

# Opcional: URL de um webhook do Discord (Configurações do servidor >
# Integrações > Webhooks) usada só pra avisar num canal se o processo do
# bot cair repetidamente e o systemd desistir de reiniciar sozinho (veja
# deploy/musicbot.service e deploy/alert_webhook.sh). Só faz sentido na
# VPS — deixe vazio localmente.
ALERT_WEBHOOK_URL=
